{
  "name": "refd",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "AI Search Monitoring",
  "displayName": "refd.ai",
  "keywords": [
    "ai-search",
    "ai-visibility",
    "brand-monitoring",
    "chatgpt",
    "perplexity",
    "gemini",
    "citations",
    "share-of-voice",
    "cloudflare-workers"
  ],
  "homepage": "https://refd.ai",
  "author": {
    "email": "h@emaitchess.com",
    "name": "Mohammad Hamza Suhail",
    "url": "https://emaitchess.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaitchess/refd.git"
  },
  "bugs": {
    "url": "https://github.com/emaitchess/refd/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun run sitemap && vite build",
    "check": "wrangler types && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply refd --local",
    "db:migrate:remote": "wrangler d1 migrations apply refd --remote",
    "db:reset": "bash scripts/reset-local-db.sh",
    "deploy": "bun run build && bun run db:migrate:remote && wrangler deploy",
    "dev": "bun run sitemap && wrangler d1 migrations apply refd --local && caddy start --config Caddyfile 2>/dev/null; trap 'caddy stop 2>/dev/null' EXIT; vite dev",
    "lint:fix": "biome check --write .",
    "lint": "biome check .",
    "prepare": "husky",
    "preview": "vite preview",
    "sitemap": "bun scripts/generate-sitemap.ts",
    "test": "bun test",
    "types": "wrangler types"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@paper-design/shaders-react": "^0.0.77",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "disposable-email-domains": "^1.0.62",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.5.0",
    "hono": "^4.12.30",
    "jose": "^6.2.4",
    "lenis": "^1.3.25",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8.2.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.9",
    "unified": "^11.0.5",
    "validator": "^13.15.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@cloudflare/vite-plugin": "1.47.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "4.114.0"
  }
}
