# Local HTTPS front for the dev server: https://refdlocal.io → vite on :5173.
# 127.0.0.1 refdlocal.io lives in /etc/hosts; `tls internal` uses Caddy's local
# CA (run `caddy trust` once to add it to the keychain).
# Usage: caddy run   (alongside `bun run dev`)
refdlocal.io {
	tls internal
	reverse_proxy localhost:5173
}
