---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout
  title="Page not found | refd"
  description="The requested page could not be found."
  indexable={false}
>
  <main
    class="flex min-h-svh items-center justify-center border-border border-b bg-bg px-5 text-primary"
  >
    <div class="w-full max-w-xl border border-border bg-bg-card p-8">
      <p
        class="font-mono text-[11px] text-accent uppercase tracking-[0.16em]"
      >
        404
      </p>
      <h1 class="mt-4 text-[38px] tracking-[-0.035em]">Page not found.</h1>
      <p class="mt-4 text-secondary leading-7">
        The page may have moved, or the address may be incorrect.
      </p>
      <a href="/" class="btn-primary mt-7">return home</a>
    </div>
  </main>
</PublicLayout>
