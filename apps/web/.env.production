# Public build-time config for `astro build` (production). Non-secret.
PUBLIC_DASHBOARD_ORIGIN=https://dash.refd.ai
PUBLIC_ANALYTICS_HOSTNAME=refd.ai
PUBLIC_UMAMI_HOST_URL=https://analytics.tunnl.xyz
# The umami website id, shared with the dashboard: one website covers refd.ai
# and dash.refd.ai so the activation funnel can span both. Empty ships no
# tracker at all, which is what a self-hosted build wants.
PUBLIC_UMAMI_WEBSITE_ID=10a1c75c-a0e7-4ab5-afd4-05dfb091ad3f
