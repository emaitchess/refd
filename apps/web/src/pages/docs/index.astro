---
import { getCollection } from 'astro:content';
import ContentCard from '../../components/ContentCard.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import {
  byPublishedDate,
  contentPath,
  formatContentDate,
  isPublished,
} from '../../lib/content';
import '../../styles/global.css';
import '../../styles/content.css';

const entries = (await getCollection('docs'))
  .filter(isPublished)
  .sort(byPublishedDate);
const site = Astro.site ?? new URL('https://refd.ai');
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'refd documentation',
    description:
      'Documentation for setting up, operating, and interpreting refd AI search monitoring.',
    url: new URL('/docs', site).href,
    isPartOf: { '@id': new URL('/#website', site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL('/', site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Documentation',
        item: new URL('/docs', site).href,
      },
    ],
  },
];
---

<Base
  title="Documentation | refd"
  description="Set up refd, build a representative prompt set, understand the metrics, and inspect the raw answer evidence behind AI search monitoring."
  path="/docs"
  structuredData={structuredData}
>
  <SiteHeader />
  <main>
    <div class="content-rail">
      <header class="content-index-hero">
        <p class="section-index">Documentation</p>
        <h1>Operate refd with the evidence in view.</h1>
        <p>
          Set up a workspace, choose representative buyer questions, understand
          each metric, and trace the report back to the AI answers that produced
          it.
        </p>
      </header>

      <section class="content-index-section" aria-labelledby="guides-title">
        <div class="content-section-head">
          <p class="section-index">Start here</p>
          <h2 id="guides-title">Guides</h2>
        </div>
        <div class="content-card-grid">
          {
            entries.map((entry) => (
              <ContentCard
                href={contentPath('docs', entry.id)}
                eyebrow={entry.data.eyebrow}
                title={entry.data.title}
                description={entry.data.description}
                meta={formatContentDate(entry.data.publishedAt)}
              />
            ))
          }
        </div>
      </section>

      <section class="content-index-section" aria-labelledby="reference-title">
        <div class="content-section-head">
          <p class="section-index">Reference</p>
          <h2 id="reference-title">Understand the system</h2>
        </div>
        <div class="content-card-grid">
          <ContentCard
            href="/methodology"
            eyebrow="Methodology"
            title="How refd measures AI search visibility"
            description="Collection, repeated sampling, scoring, aggregation, auditability, and the limits of every metric."
          />
          <ContentCard
            href="/agents"
            eyebrow="Agent access"
            title="Connect through MCP"
            description="Read a workspace from Claude, ChatGPT, or any compatible client with one revocable read-only grant."
          />
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</Base>
