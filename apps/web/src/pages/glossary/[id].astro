---
import {
  type GlossaryEntry,
  GLOSSARY_ENTRIES,
  relatedGlossaryEntries,
} from '@refd/core/glossary-index';
import type { GetStaticPaths } from 'astro';
import ContentCard from '../../components/ContentCard.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { CREATE_ACCOUNT_URL } from '../../consts';
import Base from '../../layouts/Base.astro';
import '../../styles/global.css';
import '../../styles/content.css';

interface Props {
  entry: GlossaryEntry;
}

export const getStaticPaths = (() =>
  GLOSSARY_ENTRIES.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
const related = relatedGlossaryEntries(entry);
const site = Astro.site ?? new URL('https://refd.ai');

// Concepts are category vocabulary rather than refd's own, so they cannot make
// the "read from the same source the product reads" claim the other two kinds
// make. Everything below that differs between kinds is derived here.
const isConcept = entry.kind === 'concept';
const kindLabel =
  entry.kind === 'metric' ? 'Metric' : isConcept ? 'Concept' : 'Term';
const entryLabel = (kind: GlossaryEntry['kind']) =>
  kind === 'metric' ? 'Metric' : kind === 'concept' ? 'Concept' : 'Term';
const detailsHeading = isConcept
  ? 'What it means in practice'
  : 'How it is calculated';
const description = isConcept
  ? `${entry.definition} What it means for measuring AI search visibility, and where the claims around it stop being verifiable.`
  : `${entry.definition} How refd calculates it, and where it stops being reliable.`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTerm',
    '@id': new URL(entry.path, site).href,
    name: entry.title,
    description: entry.definition,
    termCode: entry.id,
    inDefinedTermSet: {
      '@type': 'DefinedTermSet',
      '@id': new URL('/glossary#termset', site).href,
      name: 'refd AI search monitoring glossary',
      url: new URL('/glossary', site).href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Glossary',
        item: new URL('/glossary', site).href,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: entry.title,
        item: new URL(entry.path, site).href,
      },
    ],
  },
];
---

<Base
  title={`${entry.title} | refd glossary`}
  description={description}
  path={entry.path}
  markdownPath={`${entry.path}.md`}
  structuredData={structuredData}
>
  <SiteHeader />
  <main>
    <article>
      <div class="content-rail">
        <header class="content-hero">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              <li><a href="/glossary">Glossary</a></li>
              <li><span aria-current="page">{entry.title}</span></li>
            </ol>
          </nav>
          <p class="section-index">
            {kindLabel} &middot; {entry.category}
          </p>
          <h1>{entry.title}</h1>
        </header>

        <section class="answer-box" aria-labelledby="definition">
          <p class="eyebrow" id="definition">Definition</p>
          <p>{entry.definition}</p>
        </section>

        <div class="content-body content-body--solo">
          <div class="prose">
            <h2 id="details">{detailsHeading}</h2>
            <p>{entry.details}</p>

            <h2 id="where-to-see-it">
              {isConcept ? 'How refd treats it' : 'Where to see it'}
            </h2>
            <p>
              {
                entry.kind === 'metric'
                  ? 'This metric appears in the refd dashboard and in the no-signup demo, and every value links back to the AI answer it was scored from. A number you cannot trace to an answer cannot be checked, so refd keeps the raw response behind each one.'
                  : entry.kind === 'concept'
                    ? 'This is category vocabulary, not a refd metric. refd measures what AI answers actually said across repeated runs, and publishes the raw answer behind every number. Where a term above carries a claim about what causes visibility, refd treats that claim as a hypothesis to test rather than a setting to configure.'
                    : 'This term describes part of how refd collects and scores AI answers. The methodology page sets out the full contract, and the demo shows the same concepts against a live sample workspace.'
              }
            </p>
            <p>
              {
                isConcept
                  ? 'This definition is editorial. It describes how the term is used across the field rather than something the software computes, so unlike the metric pages it is not generated from the product.'
                  : 'The definition above is the one the product uses. It is read directly from the same source the dashboard and the MCP server read, so this page cannot drift from the software.'
              }
            </p>
          </div>
        </div>

        {
          related.length > 0 && (
            <section class="related-content" aria-labelledby="related-title">
              <p class="section-index">Related</p>
              <h2 id="related-title">Other {entry.category.toLowerCase()} definitions</h2>
              <div class="content-card-grid">
                {related.map((item) => (
                  <ContentCard
                    href={item.path}
                    eyebrow={entryLabel(item.kind)}
                    title={item.title}
                    description={item.definition}
                  />
                ))}
              </div>
            </section>
          )
        }

        <section class="related-content" aria-labelledby="reference-title">
          <p class="section-index">Keep reading</p>
          <h2 id="reference-title">Reference</h2>
          <div class="content-card-grid">
            <ContentCard
              href="/glossary"
              eyebrow="Glossary"
              title="All definitions"
              description="Every metric and term refd uses to measure AI search visibility, in one place."
            />
            <ContentCard
              href="/methodology"
              eyebrow="Methodology"
              title="How refd measures AI search visibility"
              description="Collection, sampling, scoring, aggregation, and the limits refd states openly."
            />
          </div>
        </section>

        <section class="content-cta">
          <div>
            <p class="section-index">See your evidence</p>
            <h2>Measure the questions your buyers ask.</h2>
          </div>
          <a class="btn btn-primary" href={CREATE_ACCOUNT_URL}>start monitoring</a>
        </section>
      </div>
    </article>
  </main>
  <SiteFooter />
</Base>
