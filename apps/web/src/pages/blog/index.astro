---
import { getCollection } from 'astro:content';
import ContentCard from '../../components/ContentCard.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import {
  byPublishedDate,
  contentPath,
  formatContentDate,
  isPublished,
} from '../../lib/content';
import '../../styles/global.css';
import '../../styles/content.css';

const entries = (await getCollection('blog'))
  .filter(isPublished)
  .sort(byPublishedDate);
const site = Astro.site ?? new URL('https://refd.ai');
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'refd blog',
    description:
      'Research, measurement notes, and practical guides for understanding brand visibility in AI answers.',
    url: new URL('/blog', site).href,
    isPartOf: { '@id': new URL('/#website', site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL('/', site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: new URL('/blog', site).href,
      },
    ],
  },
];
---

<Base
  title="Research and guides | refd"
  description="Research, measurement notes, and practical guides for understanding brand visibility, mentions, citations, and competition in AI answers."
  path="/blog"
  structuredData={structuredData}
>
  <SiteHeader />
  <main>
    <div class="content-rail">
      <header class="content-index-hero">
        <p class="section-index">Research and guides</p>
        <h1>Measure AI search without hiding the uncertainty.</h1>
        <p>
          Original research, practical measurement guidance, and transparent
          analysis of how brands appear in AI-generated answers.
        </p>
      </header>

      <section class="content-index-section" aria-labelledby="latest-title">
        <div class="content-section-head">
          <p class="section-index">Latest</p>
          <h2 id="latest-title">Published notes</h2>
        </div>
        {
          entries.length > 0 ? (
            <div class="content-card-grid">
              {entries.map((entry) => (
                <ContentCard
                  href={contentPath('blog', entry.id)}
                  eyebrow={entry.data.eyebrow}
                  title={entry.data.title}
                  description={entry.data.description}
                  meta={formatContentDate(entry.data.publishedAt)}
                />
              ))}
            </div>
          ) : (
            <div class="content-empty">
              <h2>The first research note is in preparation.</h2>
              <p>
                Start with the published methodology and documentation. New
                research and field notes will appear here and in the RSS feed.
              </p>
            </div>
          )
        }
      </section>

      <section class="content-index-section" aria-labelledby="foundation-title">
        <div class="content-section-head">
          <p class="section-index">Foundation</p>
          <h2 id="foundation-title">Read the measurement contract first</h2>
        </div>
        <div class="content-card-grid">
          <ContentCard
            href="/methodology"
            eyebrow="Methodology"
            title="How refd measures AI search visibility"
            description="The definitions, denominators, safeguards, and limitations behind every reported metric."
          />
          <ContentCard
            href="/docs/getting-started"
            eyebrow="Documentation"
            title="Getting started with refd"
            description="Build a first workspace and learn how to inspect the answer evidence behind its report."
          />
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</Base>
