---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentPage from '../layouts/ContentPage.astro';
import LegalPage from '../layouts/LegalPage.astro';
import { contentPath, isPublished } from '../lib/content';

interface Props {
  entry: CollectionEntry<'pages'>;
}

export const getStaticPaths = async () => {
  const entries = (await getCollection('pages')).filter(isPublished);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const path = contentPath('pages', entry.id);
const layoutProps = {
  title: entry.data.title,
  description: entry.data.description,
  path,
  publishedAt: entry.data.publishedAt,
  updatedAt: entry.data.updatedAt,
  headings,
  breadcrumbs: [
    { href: '/', label: 'Home' },
    { href: path, label: entry.data.title },
  ],
};
---

{
  entry.data.layout === 'legal' ? (
    <LegalPage {...layoutProps}>
      <Content />
    </LegalPage>
  ) : (
    <ContentPage
      {...layoutProps}
      eyebrow={entry.data.eyebrow}
      answer={entry.data.answer}
      author={entry.data.author}
      related={entry.data.related}
      surface={entry.data.surface}
    >
      <Content />
    </ContentPage>
  )
}
