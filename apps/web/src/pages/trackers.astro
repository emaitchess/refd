---
import { getCollection } from 'astro:content';
import ContentCard from '../components/ContentCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Base from '../layouts/Base.astro';
import { contentPath, isPublished } from '../lib/content';
import '../styles/global.css';
import '../styles/content.css';

const entries = (await getCollection('pages'))
  .filter(
    (entry) =>
      isPublished(entry) &&
      entry.data.layout === 'surface' &&
      entry.data.surface !== undefined,
  )
  .sort((left, right) => left.data.order - right.data.order);
const site = Astro.site ?? new URL('https://refd.ai');
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'AI surface visibility trackers',
    description:
      'Track brand visibility across ChatGPT, Perplexity, Gemini, Google AI Mode, and Google AI Overviews with answer-level evidence.',
    url: new URL('/trackers', site).href,
    isPartOf: { '@id': new URL('/#website', site).href },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: entries.map((entry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: entry.data.title,
        url: new URL(contentPath('pages', entry.id), site).href,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL('/', site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'AI surface trackers',
        item: new URL('/trackers', site).href,
      },
    ],
  },
];
---

<Base
  title="AI visibility trackers for five answer surfaces | refd"
  description="Track brand mentions, citations, position, sentiment, and share of voice across ChatGPT, Perplexity, Gemini, Google AI Mode, and Google AI Overviews."
  path="/trackers"
  markdownPath="/trackers.md"
  structuredData={structuredData}
>
  <SiteHeader />
  <main>
    <div class="content-rail">
      <header class="content-index-hero">
        <p class="section-index">Surface trackers</p>
        <h1>Five answer surfaces. One auditable measurement contract.</h1>
        <p>
          Monitor the same buyer questions across ChatGPT, Perplexity, Gemini,
          Google AI Mode, and Google AI Overviews without blending their
          different answers, sources, or coverage into one opaque score.
        </p>
      </header>

      <section class="content-index-section" aria-labelledby="trackers-title">
        <div class="content-section-head">
          <p class="section-index">Choose a surface</p>
          <h2 id="trackers-title">Inspect where your brand appears</h2>
        </div>
        <div class="content-card-grid tracker-card-grid">
          {
            entries.map((entry) => (
              <ContentCard
                href={contentPath('pages', entry.id)}
                eyebrow={entry.data.surface?.label ?? entry.data.eyebrow}
                title={entry.data.title}
                description={entry.data.description}
                meta={entry.data.surface?.collection}
              />
            ))
          }
        </div>
      </section>

      <section class="content-index-section" aria-labelledby="contract-title">
        <div class="content-section-head">
          <p class="section-index">Shared method</p>
          <h2 id="contract-title">Comparable, without pretending the surfaces are identical</h2>
        </div>
        <div class="tracker-contract-grid">
          <article>
            <p class="eyebrow">Schedule</p>
            <h3>Track every prompt on each run.</h3>
            <p>
              AI answers vary. Completed runs build the trend before a single
              response becomes a durable claim.
            </p>
          </article>
          <article>
            <p class="eyebrow">Separate</p>
            <h3>Keep mentions and citations independent.</h3>
            <p>
              A brand can be named without a link, or cited without being named
              in the visible answer.
            </p>
          </article>
          <article>
            <p class="eyebrow">Audit</p>
            <h3>Open the answer behind every metric.</h3>
            <p>
              Review the prompt, surface, sample, prose, sources, position, and
              competitor context instead of trusting a composite score.
            </p>
          </article>
        </div>
      </section>

      <section class="content-cta">
        <div>
          <p class="section-index">Illustrative workspace</p>
          <h2>See all five surfaces in one report.</h2>
        </div>
        <a class="btn btn-primary" href="/demo">open the demo</a>
      </section>
    </div>
  </main>
  <SiteFooter />
</Base>
