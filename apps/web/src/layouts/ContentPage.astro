---
import type { MarkdownHeading } from 'astro';
import ContentCard from '../components/ContentCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { CREATE_ACCOUNT_URL } from '../consts';
import { formatContentDate } from '../lib/content';
import '../styles/global.css';
import '../styles/content.css';
import Base from './Base.astro';

interface Breadcrumb {
  href: string;
  label: string;
}

interface Related {
  href: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
  answer: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: {
    name: string;
    url?: string;
  };
  headings: MarkdownHeading[];
  breadcrumbs: Breadcrumb[];
  related: Related[];
  schemaType?: 'Article' | 'TechArticle';
}

const {
  title,
  description,
  path,
  eyebrow,
  answer,
  publishedAt,
  updatedAt,
  author,
  headings,
  breadcrumbs,
  related,
  schemaType = 'Article',
} = Astro.props;

const site = Astro.site ?? new URL('https://refd.ai');
const canonical = new URL(path, site).href;
const tableOfContents = headings.filter(
  ({ depth }) => depth === 2 || depth === 3,
);
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  headline: title,
  description,
  mainEntityOfPage: canonical,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: {
    '@type': 'Person',
    name: author.name,
    ...(author.url ? { url: author.url } : {}),
  },
  publisher: { '@id': new URL('/#organization', site).href },
  image: new URL('/og.png', site).href,
};
const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((breadcrumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: breadcrumb.label,
    item: new URL(breadcrumb.href, site).href,
  })),
};
---

<Base
  title={`${title} | refd`}
  description={description}
  path={path}
  markdownPath={`${path}.md`}
  ogType="article"
  author={author.name}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  structuredData={[articleStructuredData, breadcrumbStructuredData]}
>
  <SiteHeader />
  <main>
    <article>
      <div class="content-rail">
        <header class="content-hero">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
              {
                breadcrumbs.map((breadcrumb, index) => (
                  <li>
                    {index < breadcrumbs.length - 1 ? (
                      <a href={breadcrumb.href}>{breadcrumb.label}</a>
                    ) : (
                      <span aria-current="page">{breadcrumb.label}</span>
                    )}
                  </li>
                ))
              }
            </ol>
          </nav>
          <p class="section-index">{eyebrow}</p>
          <h1>{title}</h1>
          <p class="content-dek">{description}</p>
          <div class="content-meta">
            <span>
              By {
                author.url ? (
                  <a href={author.url} rel="author">
                    {author.name}
                  </a>
                ) : (
                  author.name
                )
              }
            </span>
            <span>
              Published{' '}
              <time datetime={publishedAt.toISOString()}>
                {formatContentDate(publishedAt)}
              </time>
            </span>
            {
              updatedAt && (
                <span>
                  Updated{' '}
                  <time datetime={updatedAt.toISOString()}>
                    {formatContentDate(updatedAt)}
                  </time>
                </span>
              )
            }
          </div>
        </header>

        <section class="answer-box" aria-labelledby="short-answer">
          <p class="eyebrow" id="short-answer">Short answer</p>
          <p>{answer}</p>
        </section>

        <div class="content-body">
          {
            tableOfContents.length > 0 && (
              <aside class="content-toc">
                <p class="eyebrow">On this page</p>
                <nav aria-label="On this page">
                  <ol>
                    {tableOfContents.map((heading) => (
                      <li data-depth={heading.depth}>
                        <a href={`#${heading.slug}`}>{heading.text}</a>
                      </li>
                    ))}
                  </ol>
                </nav>
              </aside>
            )
          }
          <div class="prose">
            <slot />
          </div>
        </div>

        {
          related.length > 0 && (
            <section class="related-content" aria-labelledby="related-title">
              <p class="section-index">Keep reading</p>
              <h2 id="related-title">Related resources</h2>
              <div class="content-card-grid">
                {related.map((item) => (
                  <ContentCard
                    href={item.href}
                    eyebrow="Related"
                    title={item.title}
                    description={item.description}
                  />
                ))}
              </div>
            </section>
          )
        }

        <section class="content-cta">
          <div>
            <p class="section-index">See your evidence</p>
            <h2>Measure the questions your buyers ask.</h2>
          </div>
          <a class="btn btn-primary" href={CREATE_ACCOUNT_URL}>start monitoring</a>
        </section>
      </div>
    </article>
  </main>
  <SiteFooter />
</Base>

<script>
  import { activeTocHeadingId } from '../lib/toc';

  const toc = document.querySelector<HTMLElement>('.content-toc');
  const prose = document.querySelector<HTMLElement>('.prose');
  const headings = Array.from(
    document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]'),
  );
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.content-toc a[href^="#"]'),
  );

  if (toc && prose && headings.length > 0 && links.length > 0) {
    let frame: number | null = null;

    const update = () => {
      frame = null;
      const activeId = activeTocHeadingId({
        contentTop: prose.getBoundingClientRect().top,
        headings: headings.map((heading) => ({
          id: heading.id,
          top: heading.getBoundingClientRect().top,
        })),
        anchor: Math.min(160, window.innerHeight * 0.25),
        atPageEnd:
          window.scrollY + window.innerHeight >=
          document.documentElement.scrollHeight - 2,
      });

      for (const link of links) {
        if (link.getAttribute('href') === `#${activeId}`) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      }
    };

    const scheduleUpdate = () => {
      if (frame === null) {
        frame = window.requestAnimationFrame(update);
      }
    };

    update();
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
  }
</script>
