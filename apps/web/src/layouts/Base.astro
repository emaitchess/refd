---
import '@fontsource-variable/inter';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  markdownPath?: string;
  ogImage?: string;
  ogType?: 'article' | 'website';
  noindex?: boolean;
  author?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  structuredData?: Record<string, unknown>[];
}

const {
  title = 'refd | open-source AI search monitoring',
  description = 'Track where your brand appears in AI answers, who appears instead, and the evidence behind every mention, citation, position, and score.',
  path = '/',
  markdownPath,
  ogImage = '/og.png',
  ogType = 'website',
  noindex = false,
  author = 'refd',
  publishedAt,
  updatedAt,
  structuredData = [],
} = Astro.props;

const site = Astro.site ?? new URL('https://refd.ai');
const canonical = new URL(path, site).href;
const ogImageUrl = new URL(ogImage, site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': new URL('/#organization', site).href,
    name: 'refd',
    url: site.href,
    logo: new URL('/apple-touch-icon.png', site).href,
    description:
      'Track where your brand appears in AI answers, who appears instead, and the evidence behind every mention, citation, position, and score.',
    sameAs: ['https://github.com/emaitchess/refd'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', site).href,
    name: 'refd',
    url: site.href,
    publisher: { '@id': new URL('/#organization', site).href },
  },
  ...structuredData,
];
const jsonLdText = JSON.stringify(jsonLd).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#080809" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f4f0" media="(prefers-color-scheme: light)" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="refd" />
    <meta name="author" content={author} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    {
      markdownPath && (
        <link
          rel="alternate"
          type="text/markdown"
          href={new URL(markdownPath, site).href}
        />
      )
    }
    <link rel="sitemap" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="refd research and documentation"
      href={new URL('/rss.xml', site).href}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="refd" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="refd: open-source AI search monitoring" />
    <meta property="og:locale" content="en_US" />
    {
      publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
    {
      updatedAt && (
        <meta
          property="article:modified_time"
          content={updatedAt.toISOString()}
        />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="refd: open-source AI search monitoring" />

    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="refd" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" id="app-favicon" href="/logo-dark.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script is:inline>
      // Apply the stored/OS theme before first paint; favicon follows the theme.
      (() => {
        try {
          const stored = localStorage.getItem('refd-theme');
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
          const icon = document.getElementById('app-favicon');
          if (icon) icon.setAttribute('href', theme === 'light' ? '/logo-light.svg' : '/logo-dark.svg');
        } catch {}
      })();
    </script>

    <Fragment set:html={`<script type="application/ld+json">${jsonLdText}</script>`} />
  </head>
  <body>
    <slot />
    <script>
      import { startAnalytics } from '../lib/analytics';

      startAnalytics();
    </script>
  </body>
</html>
