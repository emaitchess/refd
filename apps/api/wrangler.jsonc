{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "refd-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "api.refd.ai",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "GEO_COUNTRY": "US",
    "SAMPLES": "1",
    "PROMPT_BATCH_SIZE": "5",
    // refd.ai checks workspace entitlements. Self-hosters should use "all".
    "SCHEDULED_MONITORING_POLICY": "entitled",
    // The API Worker's own public origin: the base for BrightData notify
    // callbacks (with BRIGHTDATA_WEBHOOK_SECRET) and the canonical MCP resource
    // URL (<PUBLIC_BASE_URL>/mcp) and OAuth discovery.
    "PUBLIC_BASE_URL": "https://api.refd.ai",
    // Three-worker origins. Setting DASHBOARD_ORIGIN turns on credentialed CORS
    // and the cross-origin sign-in redirect; until the dashboard Worker is live
    // this is harmless (same-origin bridge requests are still allowed). Local
    // split testing overrides these in apps/api/.dev.vars.
    "PUBLIC_SITE_ORIGIN": "https://refd.ai",
    "DASHBOARD_ORIGIN": "https://dash.refd.ai",
    "API_ORIGIN": "https://api.refd.ai",
    // Dataset IDs from the BrightData dashboard (Web Scrapers → scraper → API).
    "BRIGHTDATA_DATASET_CHATGPT": "gd_m7aof0k82r803d5bjm",
    "BRIGHTDATA_DATASET_PERPLEXITY": "gd_m7dhdot1vw9a7gc1n",
    "BRIGHTDATA_DATASET_GEMINI": "gd_mbz66arm2mf9cu856y",
    "BRIGHTDATA_DATASET_GOOGLE_AI_MODE": "gd_mcswdt6z2elth3zqr2",
    // Must match the SERP API zone name in the BrightData dashboard.
    "BRIGHTDATA_SERP_ZONE": "refd_serp"
  },
  "triggers": {
    // Daily snapshot run, 06:00 UTC.
    "crons": ["0 6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "refd",
      "database_id": "8e186830-b9f4-4803-83e1-3141c9df2446",
      "migrations_dir": "../../drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "0e1e5eb02e504673a62f3000a313f783"
    }
  ],
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "731041",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "OAUTH_RATE_LIMITER",
      "namespace_id": "731042",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW",
      "bucket_name": "refd-raw"
    }
  ],
  // Workers AI (onboarding describe/competitors/prompts, phase-2 sentiment) — no
  // secret. remote:true is explicit (AI always uses the real service in dev too).
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Browser Rendering — renders a brand's site to markdown when it has no
  // llms.txt. remote:true routes the binding to the real service (quickAction is
  // not emulated locally).
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "queues": {
    "producers": [
      {
        "binding": "INGEST",
        "queue": "refd-ingest"
      }
    ],
    "consumers": [
      {
        "queue": "refd-ingest",
        // Low concurrency by design: never burst BrightData request limits.
        "max_concurrency": 3,
        "max_batch_size": 5,
        "max_retries": 8,
        "dead_letter_queue": "refd-ingest-dlq"
      },
      {
        "queue": "refd-ingest-dlq",
        "max_retries": 1
      }
    ]
  }
}
