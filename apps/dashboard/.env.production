# Public build-time config for `vite build` (production). Non-secret. Baked into
# the dashboard bundle at the cutover deploy.
VITE_API_ORIGIN=https://api.refd.ai
VITE_PUBLIC_SITE_ORIGIN=https://refd.ai
VITE_ANALYTICS_HOSTNAME=dash.refd.ai
VITE_UMAMI_HOST_URL=https://analytics.tunnl.xyz
# Must be the same umami website id as apps/web/.env.production: one website
# covers refd.ai and dash.refd.ai so the activation funnel can span both. Empty
# ships no tracker at all, which is what a self-hosted build wants.
VITE_UMAMI_WEBSITE_ID=10a1c75c-a0e7-4ab5-afd4-05dfb091ad3f
