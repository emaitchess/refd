# Public build-time config for `vite` dev (local). Non-secret (baked into the
# client). VITE_API_ORIGIN: the API Worker; VITE_PUBLIC_SITE_ORIGIN: the public
# website the dashboard links "back" to. Local same-site subdomains.
VITE_API_ORIGIN=https://api.refdlocal.io
VITE_PUBLIC_SITE_ORIGIN=https://refdlocal.io
