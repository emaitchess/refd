{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "refd-dashboard",
  "compatibility_date": "2026-07-01",
  "routes": [
    {
      "pattern": "dash.refd.ai",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  // Assets-only Worker: the React SPA with an SPA fallback for deep links.
  // Response headers (noindex, CSP) come from apps/dashboard/public/_headers.
  // No script, no bindings — all data comes from the API Worker cross-origin.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
